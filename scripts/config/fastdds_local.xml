<?xml version="1.0" encoding="UTF-8"?>
<!-- Per-participant capacity for RGB-D frames; this does not resize /dev/shm.
     Fast DDS 2.6 defaults to a 512 KiB segment, smaller than a 640x480 frame.
     Keep UDP discovery/remote interoperability, with SHM for local peers. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>piper_shm</transport_id>
        <type>SHM</type>
        <segment_size>33554432</segment_size>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>piper_udp</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="piper_local" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>piper_shm</transport_id>
          <transport_id>piper_udp</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
