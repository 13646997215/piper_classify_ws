<?xml version="1.0"?>
<!--
================================================================================
classify.world  :  workpiece classification and transport scene
================================================================================

COORDINATE CONVENTION
  World origin sits on the GROUND, at the corner of the table nearest the arm.
  The table stands ON the ground. Its top surface is at z = TABLE_H (0.35).
  The Piper arm is bolted to the table top, so piper_base_link is at z = TABLE_H.

  ARM ORIENTATION
  The arm is spawned with a +90 degree rotation about its base Z axis, so
  viewed from above it is rotated 90 degrees counter clockwise.
  Its forward direction therefore points along -X instead of +Y, and the
  working area (blocks, bins) is laid out along -X.

  This matches the reference project, where the arm also works on its left side.

  IK FEASIBILITY (verified with a numerical 6-DOF solver)
  All five work poses (3 blocks + 2 bins) solve to 0.0 mm position error and
  0.0 degree orientation error with the 45 degree tilted grasp posture:
      red_block    (-0.30,  0.00)  r = 0.30
      green_block  (-0.30, -0.14)  r = 0.33
      blue_block   (-0.30, +0.14)  r = 0.33
      bin_red      (-0.42, +0.22)  r = 0.47
      bin_blue     (-0.42, -0.22)  r = 0.47

  GRASP POSTURE
  The arm cannot do a strict vertical top-down grasp: piper_joint2 is limited
  to [0, 3.14] and piper_joint3 to [-2.967, 0], both one sided, which locks
  the elbow configuration. The workable posture is a 45 degree tilted grasp,
  which is what the real Piper does in practice.

GEOMETRY
  table          top at 0.35, slab 0.04 thick, 4 legs 0.31 long
  blocks         50 mm cubes, mass 0.1 kg, resting on the table top
  bins           open top boxes, inner cavity 0.106 x 0.106, wall height 0.09
  wrist camera   mounted on piper_link6, the eye-in-hand sensor
================================================================================
-->
<sdf version="1.6">
  <world name="classify_world">

    <!-- ==================== physics ==================== -->
    <physics name="ode_physics" default="1" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000.0</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
      </ode>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <!-- ==================== light ==================== -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <!-- ==================== ground ==================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      ==================== table ====================
      Low workbench height 0.35 m.
        top surface  z = 0.35   (slab 0.04 thick, centre 0.33)
        legs         z = 0.00 .. 0.31   (0.31 long, centre 0.155)
      The work area extends along -X, matching the arm's rotated forward axis.
      Slab spans x -0.62..0.10, y -0.42..0.42.
    -->
    <model name="table">
      <static>true</static>

      <link name="table_top_link">
        <pose>-0.26 0.00 0.33 0 0 0</pose>
        <collision name="top_collision">
          <geometry><box><size>0.72 0.84 0.04</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <geometry><box><size>0.72 0.84 0.04</size></box></geometry>
          <material>
            <ambient>0.72 0.60 0.46 1</ambient>
            <diffuse>0.72 0.60 0.46 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="leg_near_left_link">
        <pose>0.06 -0.36 0.155 0 0 0</pose>
        <visual name="leg_visual">
          <geometry><box><size>0.045 0.045 0.31</size></box></geometry>
          <material><ambient>0.26 0.26 0.28 1</ambient><diffuse>0.26 0.26 0.28 1</diffuse></material>
        </visual>
        <collision name="leg_collision">
          <geometry><box><size>0.045 0.045 0.31</size></box></geometry>
        </collision>
      </link>
      <link name="leg_near_right_link">
        <pose>0.06 0.36 0.155 0 0 0</pose>
        <visual name="leg_visual">
          <geometry><box><size>0.045 0.045 0.31</size></box></geometry>
          <material><ambient>0.26 0.26 0.28 1</ambient><diffuse>0.26 0.26 0.28 1</diffuse></material>
        </visual>
        <collision name="leg_collision">
          <geometry><box><size>0.045 0.045 0.31</size></box></geometry>
        </collision>
      </link>
      <link name="leg_far_left_link">
        <pose>-0.56 -0.36 0.155 0 0 0</pose>
        <visual name="leg_visual">
          <geometry><box><size>0.045 0.045 0.31</size></box></geometry>
          <material><ambient>0.26 0.26 0.28 1</ambient><diffuse>0.26 0.26 0.28 1</diffuse></material>
        </visual>
        <collision name="leg_collision">
          <geometry><box><size>0.045 0.045 0.31</size></box></geometry>
        </collision>
      </link>
      <link name="leg_far_right_link">
        <pose>-0.56 0.36 0.155 0 0 0</pose>
        <visual name="leg_visual">
          <geometry><box><size>0.045 0.045 0.31</size></box></geometry>
          <material><ambient>0.26 0.26 0.28 1</ambient><diffuse>0.26 0.26 0.28 1</diffuse></material>
        </visual>
        <collision name="leg_collision">
          <geometry><box><size>0.045 0.045 0.31</size></box></geometry>
        </collision>
      </link>
    </model>

    <!--
      ==================== three blocks ====================
      50 mm cubes, mass 0.1 kg, in a row along Y at x = -0.30.
      Centre height is TABLE_H + half size = 0.35 + 0.025 = 0.375,
      so each cube rests exactly on the table top with no interpenetration.
      Colours are chosen for clean HSV segmentation later in S5.
    -->
    <model name="red_block">
      <static>false</static>
      <pose>-0.30 0.00 0.375 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>8.4e-05</ixx><iyy>8.4e-05</iyy><izz>8.4e-05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.90 0.10 0.10 1</ambient><diffuse>0.90 0.10 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="green_block">
      <static>false</static>
      <pose>-0.30 -0.14 0.375 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>8.4e-05</ixx><iyy>8.4e-05</iyy><izz>8.4e-05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.10 0.80 0.10 1</ambient><diffuse>0.10 0.80 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_block">
      <static>false</static>
      <pose>-0.30 0.14 0.375 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>8.4e-05</ixx><iyy>8.4e-05</iyy><izz>8.4e-05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.10 0.20 0.90 1</ambient><diffuse>0.10 0.20 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--
      ==================== bin for red parts ====================
      Open top box: floor slab plus four walls.
        outer       0.13 x 0.13
        floor       0.012 thick, top at 0.012
        walls       0.09 tall, 0.012 thick
        inner cavity 0.106 x 0.106
      Sits on the table top, so the model origin is at z = TABLE_H.
    -->
    <model name="bin_red">
      <static>true</static>
      <pose>-0.42 0.22 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.13 0.13 0.012</size><pose>0 0 0.006 0 0 0</pose></box>
            <box><size>0.13 0.012 0.09</size><pose> 0.059 0 0.051 0 0 0</pose></box>
            <box><size>0.13 0.012 0.09</size><pose>-0.059 0 0.051 0 0 0</pose></box>
            <box><size>0.012 0.13 0.09</size><pose>0  0.059 0.051 0 0 0</pose></box>
            <box><size>0.012 0.13 0.09</size><pose>0 -0.059 0.051 0 0 0</pose></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.13 0.13 0.012</size><pose>0 0 0.006 0 0 0</pose></box>
            <box><size>0.13 0.012 0.09</size><pose> 0.059 0 0.051 0 0 0</pose></box>
            <box><size>0.13 0.012 0.09</size><pose>-0.059 0 0.051 0 0 0</pose></box>
            <box><size>0.012 0.13 0.09</size><pose>0  0.059 0.051 0 0 0</pose></box>
            <box><size>0.012 0.13 0.09</size><pose>0 -0.059 0.051 0 0 0</pose></box>
          </geometry>
          <material><ambient>0.80 0.20 0.20 1</ambient><diffuse>0.80 0.20 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== bin for blue parts ==================== -->
    <model name="bin_blue">
      <static>true</static>
      <pose>-0.42 -0.22 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.13 0.13 0.012</size><pose>0 0 0.006 0 0 0</pose></box>
            <box><size>0.13 0.012 0.09</size><pose> 0.059 0 0.051 0 0 0</pose></box>
            <box><size>0.13 0.012 0.09</size><pose>-0.059 0 0.051 0 0 0</pose></box>
            <box><size>0.012 0.13 0.09</size><pose>0  0.059 0.051 0 0 0</pose></box>
            <box><size>0.012 0.13 0.09</size><pose>0 -0.059 0.051 0 0 0</pose></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.13 0.13 0.012</size><pose>0 0 0.006 0 0 0</pose></box>
            <box><size>0.13 0.012 0.09</size><pose> 0.059 0 0.051 0 0 0</pose></box>
            <box><size>0.13 0.012 0.09</size><pose>-0.059 0 0.051 0 0 0</pose></box>
            <box><size>0.012 0.13 0.09</size><pose>0  0.059 0.051 0 0 0</pose></box>
            <box><size>0.012 0.13 0.09</size><pose>0 -0.059 0.051 0 0 0</pose></box>
          </geometry>
          <material><ambient>0.15 0.30 0.85 1</ambient><diffuse>0.15 0.30 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
  </world>
</sdf>
